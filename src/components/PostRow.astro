---
import { categoryBySlug } from '../data/categories';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  href: string;
  words?: number;
  draft?: boolean;
}
const { title, description, date, category, href, words, draft } = Astro.props;
const cat = categoryBySlug(category);
const stamp = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class="row" style={`--cat:${cat.color}`} data-category={category}>
  <a href={href} class="row__link">
    <div class="row__meta">
      <time class="meta" datetime={date.toISOString()}>{stamp}</time>
      <span class="tag">{cat.label}</span>
      {words ? <span class="meta row__words">{words.toLocaleString()} words</span> : null}
    </div>
    <div class="row__body">
      <h3 class="row__title">{draft ? <span class="row__draft">Draft</span> : null}{title}</h3>
      <p class="row__desc">{description}</p>
    </div>
  </a>

  <style>
    .row {
      border-top: 1px solid var(--line);
    }
    .row__link {
      display: grid;
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
      padding-block: 1.4rem;
      text-decoration: none;
      color: inherit;
      align-items: start;
    }
    .row__meta {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding-top: 0.25rem;
    }
    .row__title {
      font-size: 1.4rem;
      transition: color 0.15s ease;
    }
    .row__link:hover .row__title {
      color: var(--cat);
    }
    .row__desc {
      margin: 0.35rem 0 0;
      color: var(--ink-soft);
      font-size: 0.95rem;
      max-width: 46ch;
    }
    .row__words {
      color: var(--ink-soft);
    }
    .row__draft {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      vertical-align: middle;
      background: var(--ink);
      color: var(--paper);
      padding: 0.15rem 0.4rem;
      margin-right: 0.6rem;
    }
    @media (max-width: 640px) {
      .row__link {
        grid-template-columns: 1fr;
        gap: 0.6rem;
      }
      .row__meta {
        flex-direction: row;
        align-items: center;
        gap: 0.9rem;
      }
    }
  </style>
</article>
