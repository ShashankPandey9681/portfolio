---
import Base from '../../layouts/Base.astro';
import { categoryBySlug } from '../../data/categories';
import { roundedWordCount } from '../../lib/wordCount';
import { getPosts } from '../../lib/posts';
import { type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();
const cat = categoryBySlug(post.data.category);
const words = roundedWordCount(post.body);
const stamp = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={post.data.title} description={post.data.description}>
  <article class="wrap section post" style={`--cat:${cat.color}`}>
    <a href="/blog" class="meta back">← Blog</a>
    <div class="post__meta">
      <time class="meta" datetime={post.data.date.toISOString()}>{stamp}</time>
      <a href={`/blog?category=${cat.slug}`} class="tag">{cat.label}</a>
      <span class="meta post__words">{words.toLocaleString()} words</span>
    </div>
    <h1 class="post__title">{post.data.title}</h1>
    {post.data.draft && <p class="post__draft meta">Draft — visible in dev only, not published.</p>}
    <p class="post__desc prose">{post.data.description}</p>
    <hr class="divider post__rule" />
    <div class="content prose">
      <Content />
    </div>
  </article>

  <style>
    .back {
      display: inline-block;
      text-decoration: none;
      margin-bottom: 1.5rem;
    }
    .post__meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.8rem;
    }
    .post__title {
      max-width: 20ch;
    }
    .post__desc {
      margin-top: 1rem;
      font-size: 1.2rem;
      color: var(--ink-soft);
    }
    .post__words {
      margin-left: auto;
      color: var(--ink-soft);
    }
    .post__draft {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.35rem 0.6rem;
      background: var(--ink);
      color: var(--paper);
    }
    .post__rule {
      margin-block: 2rem;
    }
  </style>
</Base>
