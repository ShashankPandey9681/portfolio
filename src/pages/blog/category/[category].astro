---
import Base from '../../../layouts/Base.astro';
import PostRow from '../../../components/PostRow.astro';
import { roundedWordCount } from '../../../lib/wordCount';
import { getPosts } from '../../../lib/posts';
import { categories, categoryBySlug } from '../../../data/categories';

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const cat = categoryBySlug(category);
const posts = await getPosts(category);
---

<Base title={cat.label} description={`Posts filed under ${cat.label}.`}>
  <section class="wrap section" style={`--cat:${cat.color}`}>
    <a href="/blog" class="meta back">← All posts</a>
    <p class="eyebrow" style="color:var(--cat)">Category</p>
    <h1>{cat.label}</h1>

    <nav class="chips" aria-label="Other categories">
      {
        categories.map((c) => (
          <a
            href={`/blog?category=${c.slug}`}
            class:list={['chip', { 'is-active': c.slug === category }]}
            style={`--cat:${c.color}`}
          >
            {c.label}
          </a>
        ))
      }
    </nav>

    {
      posts.length === 0 ? (
        <p class="meta empty">No posts in this category yet.</p>
      ) : (
        <div class="rows">
          {posts.map((p) => (
            <PostRow
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              category={p.data.category}
              href={`/blog/${p.slug}`}
              words={roundedWordCount(p.body)}
              draft={p.data.draft}
            />
          ))}
        </div>
      )
    }
  </section>

  <style>
    .back {
      display: inline-block;
      text-decoration: none;
      margin-bottom: 1.2rem;
    }
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin: 1.6rem 0 0.5rem;
    }
    .chip {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 0.4rem 0.7rem;
      border: 1px solid var(--line-strong);
      color: var(--ink-soft);
      text-decoration: none;
    }
    .chip:hover {
      border-color: var(--cat);
      color: var(--cat);
    }
    .chip.is-active {
      background: var(--cat);
      color: #fff;
      border-color: var(--cat);
    }
    .empty {
      padding-block: 2rem;
    }
  </style>
</Base>
