---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const formAction = `https://formspree.io/f/${site.formspreeId}`;
const configured = site.formspreeId && site.formspreeId !== 'YOUR_FORMSPREE_ID';
---

<Base title="Contact" description="Get in touch.">
  <section class="wrap section contact">
    <p class="eyebrow">Logbook · Contact</p>
    <h1>Get in touch</h1>
    <p class="prose lede">
      Fill this in and it lands in my inbox — no address exposed to scrapers.
      Prefer social? Links are in the footer.
    </p>

    {
      !configured && (
        <p class="notice meta">
          Setup: add your Formspree form ID in <code>src/data/site.ts</code> to
          activate this form. See DEPLOY.md.
        </p>
      )
    }

    <form
      class="form"
      action={formAction}
      method="POST"
    >
      <label class="field">
        <span class="field__label">Name</span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label class="field">
        <span class="field__label">Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label class="field">
        <span class="field__label">Message</span>
        <textarea name="message" rows="6" required></textarea>
      </label>
      <button type="submit" class="btn" disabled={!configured}>
        Send message
      </button>
    </form>
  </section>

  <style>
    .lede {
      margin-top: 1rem;
      color: var(--ink-soft);
    }
    .notice {
      margin-top: 1.5rem;
      padding: 0.8rem 1rem;
      border: 1px dashed var(--line-strong);
      color: var(--ink-soft);
      background: var(--paper-sunk);
    }
    .form {
      margin-top: 2rem;
      max-width: 34rem;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .field__label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }
    input,
    textarea {
      font-family: var(--font-body);
      font-size: 1rem;
      padding: 0.7rem 0.8rem;
      border: 1px solid var(--line-strong);
      background: var(--paper);
      color: var(--ink);
      border-radius: 0;
    }
    input:focus,
    textarea:focus {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
      border-color: var(--accent);
    }
    textarea {
      resize: vertical;
    }
    .btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }
  </style>
</Base>
