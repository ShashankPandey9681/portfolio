---
import Base from '../layouts/Base.astro';
import { skills } from '../data/site';
---

<Base title="Skills" description="How I work: product, AI, craft, and tools.">
  <section class="wrap section">
    <p class="eyebrow">Logbook · Capabilities</p>
    <h1>Skills</h1>
    <p class="prose lede">
      The shape of what I do, grouped by area. 
    </p>

    <div class="grid">
      {
        skills.map((group) => (
          <section class="card">
            <h2 class="card__title">{group.area}</h2>
            <ul class="card__list">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <style>
    .lede {
      margin-top: 1rem;
      color: var(--ink-soft);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1.5rem;
      margin-top: 2.5rem;
    }
    .card {
      border-top: 2px solid var(--ink);
      padding-top: 1rem;
    }
    .card__title {
      font-size: 1.3rem;
    }
    .card__list {
      list-style: none;
      padding: 0;
      margin: 1rem 0 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .card__list li {
      padding-left: 1.1rem;
      position: relative;
      color: var(--ink-soft);
    }
    .card__list li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--accent);
    }
  </style>
</Base>
