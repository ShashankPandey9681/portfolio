---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

// Where Web3Forms sends people after a successful submission. Not linked from
// anywhere, so it is kept out of search results.
---

<Base title="Message sent" description="Thanks for getting in touch." noindex>
  <section class="wrap section thanks">
    <p class="eyebrow">Logbook · Contact</p>
    <h1>Message sent</h1>
    <p class="prose lede">
      Thanks for writing. It has landed in my inbox and I will get back to you
      — usually within a few days, occasionally longer if the baby has other
      plans.
    </p>

    <p class="actions">
      <a class="btn" href="/blog">Read something while you wait</a>
      <a href="/">Back home</a>
    </p>

    <p class="fallback">
      Did not hear back? Nudge me at <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>

  <style>
    .lede {
      margin-top: 1rem;
      color: var(--ink-soft);
    }
    .actions {
      margin-top: 2rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .fallback {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
      max-width: 34rem;
      color: var(--ink-faint);
      font-size: 0.9rem;
    }
  </style>
</Base>
